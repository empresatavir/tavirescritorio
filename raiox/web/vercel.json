{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./",
  "git": {
    "deploymentEnabled": { "main": false }
  },
  "crons": [{
    "path": "/api/cron/supabase-health",
    "schedule": "17 11 * * *"
  }],
  "rewrites": [{ "source": "/form/:token", "destination": "/form.html" }],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
      { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
      { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
      { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'" }
    ]
  }, {
    "source": "/form/(.*)",
    "headers": [{ "key": "Cache-Control", "value": "no-store" }]
  }]
}
