# Copie para config/api_keys.env apenas localmente.
# Nunca commite, envie pelo chat ou registre estas chaves em logs.

# Uma linha por Key RapidAPI. O roteador usa os nomes KEY_1, KEY_2 etc.
# Cada Key aqui é de uma conta RapidAPI distinta, com assinatura própria nos provedores.
RAPIDAPI_KEY_1=
RAPIDAPI_KEY_2=
RAPIDAPI_KEY_3=
# ... até quantas contas houver (KEY_4, KEY_5, ...).

# Pools e limites por provedor ficam em config/instagram_rapidapi.env.
# Freio preventivo global enquanto o painel não foi conferido:
RAPIDAPI_INSTAGRAM_DEFAULT_LIMIT=100
