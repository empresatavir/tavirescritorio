# Configuração não secreta da rota RapidAPI da Íris.
# Crie config/instagram_rapidapi.env a partir deste arquivo.

# Liste as Keys que têm assinatura confirmada em cada provedor, separadas por vírgula.
# Vazio = provedor bloqueado (fail-closed). O roteador rotaciona pela Key menos usada
# e coloca em cooldown a Key que responder 429/401/403.
RAPIDAPI_INSTAGRAM_KEYS_BEST_EXPERIENCE=
RAPIDAPI_INSTAGRAM_KEYS_SOCIAL_PREMIUM=

# Quota mensal por Key. O default por provedor vale para todas as Keys do pool;
# RAPIDAPI_LIMIT_<PROVEDOR>_KEY_N sobrepõe uma Key específica.
RAPIDAPI_LIMIT_BEST_EXPERIENCE_DEFAULT=100
RAPIDAPI_LIMIT_SOCIAL_PREMIUM_DEFAULT=25
RAPIDAPI_INSTAGRAM_DEFAULT_LIMIT=100
